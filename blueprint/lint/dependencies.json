{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": [
        "**/src/app.*.ts",
        "**/src/app.*.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./features/**",
                  "!./features/features.manifest.ts",
                  "!./features/features.manifest.tsx"
                ],
                "message": "main uses the features only through the manifest."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/core/**/*.ts",
        "**/src/core/**/*.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/features/**",
                  "**/app.main.ts",
                  "**/app.main.tsx",
                  "**/app.compose.ts",
                  "**/app.compose.tsx"
                ],
                "message": "core never uses a feature, the manifest or main. The composition connects them."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/features.manifest.ts",
        "**/src/features/features.manifest.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../app.*.ts",
                  "../app.*.tsx",
                  "./*/*.api.ts",
                  "./*/*.api.tsx",
                  "./*/*.service.ts",
                  "./*/*.service.tsx",
                  "./*/*.policy.ts",
                  "./*/*.policy.tsx",
                  "./*/*.store.ts",
                  "./*/*.store.tsx",
                  "./*/*.repository.ts",
                  "./*/*.repository.tsx",
                  "./*/*.client.ts",
                  "./*/*.client.tsx"
                ],
                "message": "The manifest uses only the presentation (the registration) of each feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.ts",
        "**/src/features/*/*.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../../app.*.tsx",
                  "../features.manifest.ts",
                  "../features.manifest.tsx"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.tsx",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.controller.ts",
        "**/src/features/*/*.controller.tsx",
        "**/src/features/*/*.request.ts",
        "**/src/features/*/*.request.tsx",
        "**/src/features/*/*.command.ts",
        "**/src/features/*/*.command.tsx",
        "**/src/features/*/*.page.ts",
        "**/src/features/*/*.page.tsx",
        "**/src/features/*/*.component.ts",
        "**/src/features/*/*.component.tsx",
        "**/src/features/*/*.card.ts",
        "**/src/features/*/*.card.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../../app.*.tsx",
                  "../features.manifest.ts",
                  "../features.manifest.tsx"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.tsx",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.repository.ts",
                  "./*.repository.tsx",
                  "./*.client.ts",
                  "./*.client.tsx"
                ],
                "message": "presentation never uses data: only the registration (routes) creates it for logic. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "importNames": [
                  "useEffect",
                  "useLayoutEffect",
                  "useMemo",
                  "useCallback",
                  "memo"
                ],
                "message": "A page gets its data from the loader of its route and changes it with its action: no effect to fetch data, and no manual memoization."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.api.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../../app.*.tsx",
                  "../features.manifest.ts",
                  "../features.manifest.tsx"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.tsx",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.routes.ts",
                  "./*.routes.tsx",
                  "./*.controller.ts",
                  "./*.controller.tsx",
                  "./*.request.ts",
                  "./*.request.tsx",
                  "./*.command.ts",
                  "./*.command.tsx",
                  "./*.page.ts",
                  "./*.page.tsx",
                  "./*.component.ts",
                  "./*.component.tsx",
                  "./*.card.ts",
                  "./*.card.tsx",
                  "./*.repository.ts",
                  "./*.repository.tsx",
                  "./*.client.ts",
                  "./*.client.tsx"
                ],
                "message": "The facade never uses presentation or data. The direction is facade → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.service.ts",
        "**/src/features/*/*.service.tsx",
        "**/src/features/*/*.policy.ts",
        "**/src/features/*/*.policy.tsx",
        "**/src/features/*/*.store.ts",
        "**/src/features/*/*.store.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../../app.*.tsx",
                  "../features.manifest.ts",
                  "../features.manifest.tsx"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.tsx",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.routes.ts",
                  "./*.routes.tsx",
                  "./*.controller.ts",
                  "./*.controller.tsx",
                  "./*.request.ts",
                  "./*.request.tsx",
                  "./*.command.ts",
                  "./*.command.tsx",
                  "./*.page.ts",
                  "./*.page.tsx",
                  "./*.component.ts",
                  "./*.component.tsx",
                  "./*.card.ts",
                  "./*.card.tsx",
                  "./*.api.ts"
                ],
                "message": "logic never uses presentation or the facade. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.repository.ts",
        "**/src/features/*/*.repository.tsx",
        "**/src/features/*/*.client.ts",
        "**/src/features/*/*.client.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.ts",
                  "../../app.*.tsx",
                  "../features.manifest.ts",
                  "../features.manifest.tsx"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.ts",
                  "../*/*.tsx",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.routes.ts",
                  "./*.routes.tsx",
                  "./*.controller.ts",
                  "./*.controller.tsx",
                  "./*.request.ts",
                  "./*.request.tsx",
                  "./*.command.ts",
                  "./*.command.tsx",
                  "./*.page.ts",
                  "./*.page.tsx",
                  "./*.component.ts",
                  "./*.component.tsx",
                  "./*.card.ts",
                  "./*.card.tsx",
                  "./*.service.ts",
                  "./*.service.tsx",
                  "./*.policy.ts",
                  "./*.policy.tsx",
                  "./*.store.ts",
                  "./*.store.tsx",
                  "./*.api.ts"
                ],
                "message": "data never uses presentation, logic or the facade. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/shared/*.ts",
        "**/src/shared/*.tsx",
        "**/src/shared/*/*.ts",
        "**/src/shared/*/*.tsx"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../features/**",
                  "../app.*.ts",
                  "../app.*.tsx",
                  "../../core/**",
                  "../../features/**",
                  "../../app.*.ts",
                  "../../app.*.tsx"
                ],
                "message": "shared uses no part of the application: no core, features or main."
              }
            ]
          }
        ]
      }
    }
  ]
}
