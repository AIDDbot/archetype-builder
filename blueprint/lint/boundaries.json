{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "overrides": [
    {
      "files": [
        "**/src/app.*.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./features/**",
                  "!./features/features.manifest.{ts,tsx}"
                ],
                "message": "main uses the features only through the manifest."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/core/**/*.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/features/**",
                  "**/app.{main,compose}.{ts,tsx}"
                ],
                "message": "core never uses a feature, the manifest or main. The composition connects them."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/features.manifest.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../core/**",
                  "../app.*.{ts,tsx}",
                  "./*/*.{api,service,policy,store,repository,client}.{ts,tsx}"
                ],
                "message": "The manifest uses only the presentation (the registration) of each feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.{ts,tsx}",
                  "../features.manifest.{ts,tsx}"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.{ts,tsx}",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.{controller,request,command,page,component,card}.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.{ts,tsx}",
                  "../features.manifest.{ts,tsx}"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.{ts,tsx}",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.{repository,client}.{ts,tsx}"
                ],
                "message": "presentation never uses data: only the registration (routes) creates it for logic. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "importNames": [
                  "useEffect",
                  "useLayoutEffect",
                  "useMemo",
                  "useCallback",
                  "memo"
                ],
                "message": "A page gets its data from the loader of its route and changes it with its action: no effect to fetch data, and no manual memoization."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.api.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.{ts,tsx}",
                  "../features.manifest.{ts,tsx}"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.{ts,tsx}",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.{routes,controller,request,command,page,component,card,repository,client}.{ts,tsx}"
                ],
                "message": "The facade never uses presentation or data. The direction is facade → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.{service,policy,store}.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.{ts,tsx}",
                  "../features.manifest.{ts,tsx}"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.{ts,tsx}",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.{routes,controller,request,command,page,component,card}.{ts,tsx}",
                  "./*.api.ts"
                ],
                "message": "logic never uses presentation or the facade. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/features/*/*.{repository,client}.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../core/**",
                  "../../app.*.{ts,tsx}",
                  "../features.manifest.{ts,tsx}"
                ],
                "message": "A feature never uses core, main or the manifest. The composition gives it the services of core through the contracts of shared."
              },
              {
                "group": [
                  "../*/*.{ts,tsx}",
                  "!../*/*.api.ts"
                ],
                "message": "A feature uses a different feature only through its facade ({feature}.api.ts)."
              },
              {
                "group": [
                  "./*.{routes,controller,request,command,page,component,card,service,policy,store}.{ts,tsx}",
                  "./*.api.ts"
                ],
                "message": "data never uses presentation, logic or the facade. The direction is presentation → logic → data."
              }
            ],
            "paths": [
              {
                "name": "react",
                "message": "Only a .tsx file of presentation, core or shared uses React: facades, logic and data are plain TypeScript, which unit tests prove."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/shared/*.{ts,tsx}",
        "**/src/shared/*/*.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "{..,../..}/{core,features}/**",
                  "{..,../..}/app.*.{ts,tsx}"
                ],
                "message": "shared uses no part of the application: no core, features or main."
              }
            ]
          }
        ]
      }
    }
  ]
}
