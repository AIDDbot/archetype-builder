{
  "name": "archetype-cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "projects/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "test": "vp run -r test",
    "upgrade": "npx npm-check-updates@latest -u --workspaces --root && npm install",
    "check": "vp check && vp test run --passWithNoTests",
    "fix": "vp check --fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "vite-plus": "^1.3.0"
  }
}
