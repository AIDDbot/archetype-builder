{
  "name": "archetype-web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "projects/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "start": "vp run --parallel --log labeled --filter \"./projects/*\" --filter \"!e2e\" start",
    "test": "vp run --filter \"./projects/*\" --filter \"!e2e\" test",
    "test:e2e": "vp run --filter e2e test",
    "upgrade": "npx npm-check-updates@latest -u --workspaces --root && npm install && npm exec -w e2e -- playwright install chromium",
    "check": "node tools/scripts/check.mjs",
    "fix": "vp check --fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "vite-plus": "^1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  }
}
